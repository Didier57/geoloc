# --- Serveur ---
# Port d'écoute du serveur API (interne)
SERVER_PORT=4000
# URL publique de l'application (sert à définir le cookie de session)
APP_URL=http://localhost:8080

# Secret de signature des sessions (chaîne aléatoire longue)
SESSION_SECRET=change-me
# Clé de chiffrement du token Home Assistant (64 caractères hexadécimaux = 32 octets)
COOKIE_ENC_KEY=change-me-64-hex

# Force le flag "Secure" du cookie (true/false).
# Vide = déduit automatiquement de APP_URL (secure si https).
COOKIE_SECURE=

# Compte administrateur créé automatiquement au premier démarrage
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Fichier de données persistantes (utilisateurs + configuration Home Assistant)
DATA_FILE=/data/geoloc.json

# Fuseau horaire du serveur (utilisé pour l'archivage quotidien à 00:00 et les jours)
TZ=Europe/Paris
# Nombre de jours rattrapés depuis Home Assistant au démarrage (Home Assistant n'en garde que 8)
ARCHIVE_BACKFILL_DAYS=8

# Analyse marche / voiture des points (vitesse calculée entre deux points successifs)
# En dessous de STILL_MAX_KMH le device est considéré immobile
STILL_MAX_KMH=2
# Entre STILL_MAX_KMH et WALK_MAX_KMH : à pied ; au dessus : en voiture
WALK_MAX_KMH=8

# --- Images Docker publiées sur GHCR ---
GEOLOC_IMAGE_TAG=latest
